cask "muzik" do
  version "@VERSION@"
  sha256 "@MACOS_ARM64_SHA256@"

  # Apple Silicon DMG from the unified Muzik release. Intel Macs are served by
  # the portable JAR (Java 21+) attached to the same release.
  url "https://github.com/MuzikGroup/Muzik/releases/download/v#{version}/Muzik-#{version}-macos-arm64.dmg"
  name "Muzik"
  desc "YouTube Music desktop client"
  homepage "https://github.com/MuzikGroup/Muzik"

  livecheck do
    url :url
    strategy :github_latest
  end

  app "Muzik.app"
end
