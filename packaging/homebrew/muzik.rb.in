cask "muzik" do
  arch arm: "arm64", intel: "x64"

  version "@VERSION@"
  sha256 arm:   "@MACOS_ARM64_SHA256@",
         intel: "@MACOS_X64_SHA256@"

  url "https://github.com/MuzikGroup/MuzikDesktop/releases/download/v#{version}/muzik-desktop-macos-#{arch}-#{version}.dmg"
  name "Muzik"
  desc "YouTube Music desktop client"
  homepage "https://github.com/MuzikGroup/MuzikDesktop"

  livecheck do
    url :url
    strategy :github_latest
  end

  app "Muzik.app"
end
